# Copy to .env and source it, or pass inline. Phase 0 defaults match the dev stack.
KAFKA_BROKERS=localhost:9092
# Connect as the least-privilege app role so RLS engages — the superuser
# `devintel` bypasses RLS. See db/migrations/0003_app_role.sql.
POSTGRES_DSN=postgres://devintel_app:devintel_app@localhost:5432/devintel
GITHUB_WEBHOOK_SECRET=dev-secret
LISTEN_ADDR=:8080
CONSUMER_GROUP=normalizer

# Connector-github enricher (P1.C): raw.github → enriched.github. Without GitHub
# App creds (below) it runs as a pass-through, so the normalizer still gets events.
CONNECTOR_CONSUMER_GROUP=connector-github
# Fetch per-file patch text via REST (off by default — large; Phase-3 AI-11 turns on).
ENRICH_PATCHES=
ENRICH_PATCH_MAX_BYTES=65536

# Archiver (raw payloads → object store; the replay safety net, ADR-010).
ARCHIVER_CONSUMER_GROUP=archiver
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=devintel
S3_SECRET_KEY=devintel12345
S3_RAW_BUCKET=raw-github

# Outbox relay (publishes staged canonical events → Kafka, ADR-012). Connects as
# the dedicated relay role that may drain the outbox across tenants, nothing else.
RELAY_DSN=postgres://devintel_relay:devintel_relay@localhost:5432/devintel
RELAY_POLL_INTERVAL=250ms
RELAY_BATCH_SIZE=100

# GitHub App credentials (P1.A). The private key is read from PEM at this path —
# in production it comes from Vault (NFR-6.2); the file path is the dev seam.
# Leave unset until a real App is registered; the auth lib needs no app to build/test.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
# Optional GitHub Enterprise Server base (defaults to https://api.github.com).
GITHUB_API_BASE=https://api.github.com
